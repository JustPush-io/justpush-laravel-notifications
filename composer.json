{
    "name": "justpush/laravel-notification-channel",
    "description": "JustPush notification channel for Laravel: send push notifications to iOS and Android with $user->notify().",
    "keywords": [
        "laravel",
        "notifications",
        "justpush",
        "push notifications",
        "notification channel"
    ],
    "homepage": "https://justpush.io",
    "license": "MIT",
    "authors": [
        {
            "name": "JustPush.io",
            "email": "info@justpush.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "justpush/justpush-php-sdk": "^1.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\JustPush\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\JustPush\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\JustPush\\JustPushServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
